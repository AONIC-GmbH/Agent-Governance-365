# Generated by `npm run setup:azure`. Copy to terraform.tfvars or re-run the wizard.
# Values below match a typical Runpipe layout (App Service + SWA + Postgres + Key Vault).

subscription_id = "" # az account show --query id -o tsv

prefix      = "runpipe"
environment = "dev"
location    = "westeurope"

# Leave blank to derive names: rg-runpipe-dev, runpipe-api, runpipe-web, runpipe-pg-dev, runpipe-kv-dev
resource_group_name = ""
api_name            = ""
web_name            = ""
postgres_name       = ""
key_vault_name      = ""
name_suffix         = ""

app_service_sku     = "B1"                 # F1 (demo) · B1 (current-style) · S1 (slots) · P1v3 (prod)
node_version        = "22-lts"
postgres_sku        = "B_Standard_B1ms"    # B_Standard_B2s · GP_Standard_D2s_v3
postgres_version    = "16"
postgres_storage_mb = 32768
postgres_ha         = false
postgres_network_mode       = "public_azure"     # public_app_outbound · private_endpoint
developer_ip                = ""                 # your public IP for migrate/seed
extra_postgres_firewall_ips = []                 # after first apply: terraform output api_outbound_ip_addresses
swa_sku             = "Free"               # Standard for SLA / extra custom domains

enable_app_insights = true
enable_nightly_jobs = false

entra_tenant_id   = ""
entra_client_id   = ""
default_tenant_id = "t1"

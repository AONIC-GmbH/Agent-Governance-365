# Set to "true" for local UI development without login (uses in-memory backend)
VITE_MOCK_MODE=false

# Backend API base URL (Express server)
VITE_API_BASE_URL=http://localhost:7071

# --- Microsoft Entra ID (MSAL) ---
# When VITE_ENTRA_CLIENT_ID is set and mock mode is off, login uses Microsoft instead of Supabase.
VITE_ENTRA_TENANT_ID=your-entra-tenant-id
VITE_ENTRA_CLIENT_ID=your-spa-client-id
# Optional: custom API scope once exposed in App Registration
# VITE_ENTRA_API_SCOPE=api://your-api-client-id/access_as_user

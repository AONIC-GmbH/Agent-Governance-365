# In-memory store when DATABASE_URL is unset; Postgres when set
# USE_MEMORY_STORE=1
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/runpipe?sslmode=require
# DATABASE_SSL=true
# TLS cert verification is ON by default when DATABASE_SSL=true. Optional overrides:
# DATABASE_SSL_CA=                     # PEM file path or inline PEM to pin a CA
# DATABASE_SSL_REJECT_UNAUTHORIZED=    # set to "false" ONLY as a temporary fallback (insecure)

# Microsoft Entra ID — JWT validation (optional in local dev)
# ENTRA_TENANT_ID=your-tenant-id
# ENTRA_CLIENT_ID=your-app-registration-client-id

# App-only Microsoft Graph access for the collaborator directory people-picker.
# Requires the app registration to have Microsoft Graph -> Application permission
# User.Read.All with admin consent granted, plus a client secret. When unset, the
# directory search returns no results (feature disabled).
# ENTRA_CLIENT_SECRET=your-app-registration-client-secret

# Power Platform Inventory API — delegated auth (inventory_sync job).
# Dedicated inventory app registration (public client). NOT app-only SP:
# resourcequery requires delegated user context + refresh token.
# PP_INVENTORY_CLIENT_ID=your-inventory-app-client-id
# PP_REFRESH_TOKEN=from bootstrap script (local); use Key Vault in production
# PP_INVENTORY_AUTH=delegated
# (No client secret for refresh — bootstrap uses device code / public client)
# PP_TENANT_ID=your-tenant-id (defaults to ENTRA_TENANT_ID)
# PP_API_BASE_URL=https://api.powerplatform.com
#
# --- Production (App Service + Key Vault) — see DEPLOYMENT.md ---
# 1. Store secrets in Key Vault (do NOT paste tokens into App Service as plain text):
#      PP-REFRESH-TOKEN            <- from bootstrap-inventory-token.js
#      INTERNAL-JOB-TRIGGER-SECRET <- long random string for /internal/jobs/*
# 2. App Service system-assigned MI needs role "Key Vault Secrets User" on the vault.
# 3. App settings (plain): PP_INVENTORY_AUTH, PP_INVENTORY_CLIENT_ID, PP_TENANT_ID, …
# 4. App settings (Key Vault references):
#      PP_REFRESH_TOKEN=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/PP-REFRESH-TOKEN/)
#      INTERNAL_JOB_TRIGGER_SECRET=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/INTERNAL-JOB-TRIGGER-SECRET/)
# 5. Restart App Service after changing settings; confirm references show as Resolved.
# 6. Deploy API via your pipeline; schedule nightly POST /internal/jobs/inventory_sync/run.

# Legacy app-only SP (403 on inventory API — do not use for inventory_sync):
# PP_CLIENT_ID=your-app-only-client-id
# PP_CLIENT_SECRET=your-app-only-client-secret

# Power BI Admin / Scanner API (powerbi_inventory_sync job).
# Uses the same tenant as ENTRA_TENANT_ID / PP_TENANT_ID (no separate PBI tenant).
# Service principal with Fabric admin API access; enable tenant admin API settings.
# PBI_CLIENT_ID=your-pbi-app-client-id
# PBI_CLIENT_SECRET=your-pbi-app-client-secret
# PBI_API_BASE_URL=https://api.powerbi.com

# CoE Starter Kit via Dataverse (app-only) for the coe_sync job. Dataverse
# fully supports service-principal auth, so this powers the unattended nightly
# sync. The SP must be added as an Application User in the CoE environment with
# a security role that can read the CoE tables. Tenant/client default to the
# PP_* values, so you can reuse the same SP. When DATAVERSE_URL is unset, the
# coe_sync job fails fast with a clear "not configured" message.
# DATAVERSE_URL=https://orgXXXXXXXX.crm.dynamics.com
# DATAVERSE_TENANT_ID=your-tenant-id
# DATAVERSE_CLIENT_ID=your-sp-client-id
# DATAVERSE_CLIENT_SECRET=your-sp-client-secret
# Optional: override the CoE tables ingested (JSON array). Defaults cover
# environments, apps, cloud flows, and chatbots/agents.
# COE_TABLES=[{"entitySet":"admin_environments","idField":"admin_environmentid","kind":"environment"}]

# Copilot Agent Kit Dataverse org (separate from CoE). Used by copilot_kit_usage_sync
# to read cat_agentusagehistories (daily billed/unbilled Copilot credits).
# Credentials fall back to DATAVERSE_* / PP_* when unset. The SP must be an
# Application User in the kit environment with read access to that table.
# COPILOT_KIT_DATAVERSE_URL=https://orgXXXXXXXX.crm4.dynamics.com
# COPILOT_KIT_DATAVERSE_TENANT_ID=your-tenant-id
# COPILOT_KIT_DATAVERSE_CLIENT_ID=your-sp-client-id
# COPILOT_KIT_DATAVERSE_CLIENT_SECRET=your-sp-client-secret

# Shared secret for the internal job trigger (/internal/jobs/:jobType/run).
# Local: set a long random string. Production (App Service): Key Vault reference
#   INTERNAL_JOB_TRIGGER_SECRET=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/INTERNAL-JOB-TRIGGER-SECRET/)
# The nightly Logic App must GET that secret with its managed identity and send
# the resolved value in x-internal-job-secret — not the @Microsoft.KeyVault string.
# When unset, the internal trigger is disabled.
# INTERNAL_JOB_TRIGGER_SECRET=generate-a-long-random-string

# Default tenant for new Entra users when email domain doesn't match
DEFAULT_TENANT_ID=t1

# Comma-separated browser origins allowed by CORS (localhost is always allowed).
# In production set this to the deployed frontend URL, e.g.:
# ALLOWED_ORIGINS=https://your-frontend.azurestaticapps.net
# ALLOWED_ORIGINS=

PORT=7071
